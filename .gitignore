# This public repository intentionally tracks only the curated pipeline source.
# Everything else is denied by default so large generated assets cannot be
# added accidentally with `git add .`.
*

!/.gitignore
!/README.md
!/requirements.txt

!/agent/
!/agent/__init__.py
!/agent/shared_representation/
!/agent/shared_representation/**
!/agent/scene_and_gameplay_planning/
!/agent/scene_and_gameplay_planning/**
!/agent/game_realization/
!/agent/game_realization/**
!/agent/gameplay_logic/
!/agent/gameplay_logic/**
agent/**/__pycache__/
